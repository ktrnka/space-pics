<!doctype html>
<meta charset="utf-8">
<title>{{ source.name }} explorer</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 1rem; background: #111; color: #ddd; }
  h2 { margin: 2rem 0 0.25rem; } h3 { margin: 1rem 0 0.25rem; font-weight: normal; color: #aaa; }
  .grid { display: flex; flex-wrap: wrap; gap: 6px; }
  figure { margin: 0; width: 160px; }
  img { width: 160px; height: 120px; object-fit: cover; background: #222; display: block; }
  figcaption { font-size: 11px; color: #999; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  a { color: #8cf; }
  table { border-collapse: collapse; } th { font-size: 11px; color: #aaa; font-weight: normal; padding: 2px 4px; position: sticky; top: 0; background: #111; }
  th.row { text-align: left; position: sticky; left: 0; }
  td { padding: 1px; } td img { width: 96px; height: 96px; object-fit: cover; }
  .wrap { overflow-x: auto; }
  .meta { color: #888; font-size: 12px; }
</style>
<h1>{{ source.name }} <span class="meta">· {{ source.subject }} · {{ source.release_tier }} · {{ n }} candidates</span></h1>
<p><a href="index.html">all sources</a></p>
{% macro fig(c) -%}
  <figure><a href="{{ c.image_url }}"><img loading="lazy" src="{{ c.thumbnail_url or c.preview_url }}" alt=""></a>
  <figcaption title="{{ c.title }} {{ c.captured_at.isoformat() }}">{{ c.captured_at.strftime('%m-%d %H:%M') }} {{ c.meta.get('filter_name') or c.meta.get('measurement') or c.instrument }}</figcaption></figure>
{%- endmacro %}
{% if layout == "sequence" %}
  {% for sol, seqs in sols.items() %}
  <h2>Sol {{ sol }} <span class="meta">{{ seqs | length }} sequences</span></h2>
  {% for seq, frames in seqs.items() %}
  <h3>{{ seq }} · {{ frames[0].instrument }}{% if frames | length > 1 and frames[-1].instrument != frames[0].instrument %} + {{ frames[-1].instrument }}{% endif %} · {{ frames | length }} frames · {{ frames[0].captured_at.strftime('%H:%M') }}–{{ frames[-1].captured_at.strftime('%H:%M') }} UTC</h3>
  <div class="grid">{% for c in frames %}{{ fig(c) }}{% endfor %}</div>
  {% endfor %}
  {% endfor %}
{% elif layout == "timegrid" %}
  <div class="wrap"><table>
    <tr><th class="row"></th>{% for col in columns %}<th>{{ col }}</th>{% endfor %}</tr>
    {% for instrument, cells in rows.items() %}
    <tr><th class="row">{{ instrument }}</th>
      {% for col in columns %}<td>{% if cells.get(col) %}<a href="{{ cells[col].image_url }}"><img loading="lazy" src="{{ cells[col].thumbnail_url or cells[col].preview_url }}" title="{{ cells[col].captured_at.isoformat() }}"></a>{% endif %}</td>{% endfor %}
    </tr>
    {% endfor %}
  </table></div>
{% else %}
  {% for instrument, items in groups.items() %}
  <h2>{{ instrument }} <span class="meta">({{ items | length }} shown)</span></h2>
  <div class="grid">{% for c in items %}{{ fig(c) }}{% endfor %}</div>
  {% endfor %}
{% endif %}
