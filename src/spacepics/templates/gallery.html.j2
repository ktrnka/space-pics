<!doctype html>
<meta charset="utf-8">
<title>{{ source }} candidates</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 1rem; background: #111; color: #ddd; }
  h2 { margin-top: 2rem; }
  .grid { display: flex; flex-wrap: wrap; gap: 8px; }
  figure { margin: 0; width: 200px; }
  img { width: 200px; height: 150px; object-fit: cover; background: #222; }
  figcaption { font-size: 11px; color: #999; word-break: break-all; }
  a { color: #8cf; }
</style>
<h1>{{ source }}</h1>
<p><a href="index.html">all sources</a></p>
{% for instrument, items in groups.items() %}
<h2>{{ instrument }} <small>({{ items | length }} shown)</small></h2>
<div class="grid">
{% for c in items %}
  <figure>
    <a href="{{ c.image_url }}"><img loading="lazy" src="{{ c.preview_url }}" alt=""></a>
    <figcaption>{{ c.captured_at.strftime('%Y-%m-%d %H:%M') }}<br>{{ c.meta.get('filter_name') or '' }}</figcaption>
  </figure>
{% endfor %}
</div>
{% endfor %}
